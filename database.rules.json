{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null || !data.exists()"
      }
    },
    "admin_settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "audit_logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "Companies": {
      "$company": {
        ".read": "auth != null",
        ".write": "auth != null",
        "Blocks": {
          "$block": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
