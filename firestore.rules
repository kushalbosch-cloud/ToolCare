rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Profile Documents: Users can only write their own user profile document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Notifications Collection: Read-only for authenticated client users (written exclusively by Cloud Functions)
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // General operational documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
